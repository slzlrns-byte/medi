DEFINE SCHEMA

    RECORD TYPE CD_MedicationRecord (
        CD_catalogID             STRING,
        CD_catalogID_ckAsset     ASSET,
        CD_createdAt             TIMESTAMP,
        CD_entityName            STRING,
        CD_formRaw               STRING,
        CD_formRaw_ckAsset       ASSET,
        CD_id                    STRING,
        CD_kindRaw               STRING,
        CD_kindRaw_ckAsset       ASSET,
        CD_name                  STRING,
        CD_name_ckAsset          ASSET,
        CD_note                  STRING,
        CD_note_ckAsset          ASSET,
        CD_purposeLine           STRING,
        CD_purposeLine_ckAsset   ASSET,
        CD_resumedAt             TIMESTAMP,
        CD_statusRaw             STRING,
        CD_statusRaw_ckAsset     ASSET,
        CD_stoppedAt             TIMESTAMP,
        CD_strengthText          STRING,
        CD_strengthText_ckAsset  ASSET,
        "___createTime"          TIMESTAMP,
        "___createdBy"           REFERENCE,
        "___etag"                STRING,
        "___modTime"             TIMESTAMP,
        "___modifiedBy"          REFERENCE,
        "___recordID"            REFERENCE QUERYABLE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_ScheduleRecord (
        CD_dosePerIntake          DOUBLE,
        CD_endDate                TIMESTAMP,
        CD_entityName             STRING,
        CD_hour                   INT64,
        CD_id                     STRING,
        CD_medicationID           STRING,
        CD_minute                 INT64,
        CD_slotKey                STRING,
        CD_slotKey_ckAsset        ASSET,
        CD_startDate              TIMESTAMP,
        CD_weekdayValues          BYTES,
        CD_weekdayValues_ckAsset  ASSET,
        "___createTime"           TIMESTAMP,
        "___createdBy"            REFERENCE,
        "___etag"                 STRING,
        "___modTime"              TIMESTAMP,
        "___modifiedBy"           REFERENCE,
        "___recordID"             REFERENCE QUERYABLE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_DoseEventRecord (
        CD_actualAt            TIMESTAMP,
        CD_entityName          STRING,
        CD_id                  STRING,
        CD_kindRaw             STRING,
        CD_kindRaw_ckAsset     ASSET,
        CD_medicationID        STRING,
        CD_quantity            DOUBLE,
        CD_scheduledAt         TIMESTAMP,
        CD_skipReason          STRING,
        CD_skipReason_ckAsset  ASSET,
        CD_slotKey             STRING,
        CD_slotKey_ckAsset     ASSET,
        CD_sourceRaw           STRING,
        CD_sourceRaw_ckAsset   ASSET,
        CD_statusRaw           STRING,
        CD_statusRaw_ckAsset   ASSET,
        "___createTime"        TIMESTAMP,
        "___createdBy"         REFERENCE,
        "___etag"              STRING,
        "___modTime"           TIMESTAMP,
        "___modifiedBy"        REFERENCE,
        "___recordID"          REFERENCE QUERYABLE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_StockEventRecord (
        CD_amount           DOUBLE,
        CD_entityName       STRING,
        CD_id               STRING,
        CD_kindRaw          STRING,
        CD_kindRaw_ckAsset  ASSET,
        CD_medicationID     STRING,
        CD_note             STRING,
        CD_note_ckAsset     ASSET,
        CD_occurredAt       TIMESTAMP,
        CD_prescriptionID   STRING,
        "___createTime"     TIMESTAMP,
        "___createdBy"      REFERENCE,
        "___etag"           STRING,
        "___modTime"        TIMESTAMP,
        "___modifiedBy"     REFERENCE,
        "___recordID"       REFERENCE QUERYABLE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_CheckInRecord (
        CD_activities               BYTES,
        CD_activities_ckAsset       ASSET,
        CD_anxiety                  INT64,
        CD_date                     TIMESTAMP,
        CD_dreamNote                STRING,
        CD_dreamNote_ckAsset        ASSET,
        CD_dreamRecall              INT64,
        CD_dreamVividness           INT64,
        CD_dreamed                  INT64,
        CD_emotionWords             BYTES,
        CD_emotionWords_ckAsset     ASSET,
        CD_energy                   INT64,
        CD_entityName               STRING,
        CD_id                       STRING,
        CD_longText                 STRING,
        CD_longText_ckAsset         ASSET,
        CD_moodScore                INT64,
        CD_nightmare                INT64,
        CD_note                     STRING,
        CD_note_ckAsset             ASSET,
        CD_questionCardID           STRING,
        CD_questionCardID_ckAsset   ASSET,
        CD_sleepMinutes             INT64,
        CD_sleepQualityRaw          STRING,
        CD_sleepQualityRaw_ckAsset  ASSET,
        CD_updatedAt                TIMESTAMP,
        "___createTime"             TIMESTAMP,
        "___createdBy"              REFERENCE,
        "___etag"                   STRING,
        "___modTime"                TIMESTAMP,
        "___modifiedBy"             REFERENCE,
        "___recordID"               REFERENCE QUERYABLE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_SymptomEntryRecord (
        CD_contextTags          BYTES,
        CD_contextTags_ckAsset  ASSET,
        CD_durationMinutes      INT64,
        CD_entityName           STRING,
        CD_id                   STRING,
        CD_note                 STRING,
        CD_note_ckAsset         ASSET,
        CD_relatedMedicationID  STRING,
        CD_severity             INT64,
        CD_sourceRaw            STRING,
        CD_sourceRaw_ckAsset    ASSET,
        CD_startedAt            TIMESTAMP,
        CD_symptomID            STRING,
        CD_symptomID_ckAsset    ASSET,
        "___createTime"         TIMESTAMP,
        "___createdBy"          REFERENCE,
        "___etag"               STRING,
        "___modTime"            TIMESTAMP,
        "___modifiedBy"         REFERENCE,
        "___recordID"           REFERENCE QUERYABLE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_PrescriptionRecord (
        CD_clinicNote                  STRING,
        CD_clinicNote_ckAsset          ASSET,
        CD_daysSupplied                INT64,
        CD_entityName                  STRING,
        CD_id                          STRING,
        CD_medicationIDValues          BYTES,
        CD_medicationIDValues_ckAsset  ASSET,
        CD_nextVisitDate               TIMESTAMP,
        CD_visitDate                   TIMESTAMP,
        "___createTime"                TIMESTAMP,
        "___createdBy"                 REFERENCE,
        "___etag"                      STRING,
        "___modTime"                   TIMESTAMP,
        "___modifiedBy"                REFERENCE,
        "___recordID"                  REFERENCE QUERYABLE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_MedicationNoteRecord (
        CD_createdAt          TIMESTAMP,
        CD_entityName         STRING,
        CD_id                 STRING,
        CD_kindRaw            STRING,
        CD_kindRaw_ckAsset    ASSET,
        CD_medicationID       STRING,
        CD_symptomID          STRING,
        CD_symptomID_ckAsset  ASSET,
        CD_text               STRING,
        CD_text_ckAsset       ASSET,
        "___createTime"       TIMESTAMP,
        "___createdBy"        REFERENCE,
        "___etag"             STRING,
        "___modTime"          TIMESTAMP,
        "___modifiedBy"       REFERENCE,
        "___recordID"         REFERENCE QUERYABLE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_DoseChangeRecord (
        CD_changedAt         TIMESTAMP,
        CD_entityName        STRING,
        CD_fromText          STRING,
        CD_fromText_ckAsset  ASSET,
        CD_id                STRING,
        CD_medicationID      STRING,
        CD_note              STRING,
        CD_note_ckAsset      ASSET,
        CD_toText            STRING,
        CD_toText_ckAsset    ASSET,
        "___createTime"      TIMESTAMP,
        "___createdBy"       REFERENCE,
        "___etag"            STRING,
        "___modTime"         TIMESTAMP,
        "___modifiedBy"      REFERENCE,
        "___recordID"        REFERENCE QUERYABLE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE Users (
        "___createTime"  TIMESTAMP,
        "___createdBy"   REFERENCE,
        "___etag"        STRING,
        "___modTime"     TIMESTAMP,
        "___modifiedBy"  REFERENCE,
        "___recordID"    REFERENCE QUERYABLE,
        roles            LIST<INT64>,
        GRANT WRITE TO "_creator",
        GRANT READ TO "_world"
    );
