{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/slzlrns-byte/medi/blob/main/data/schema/drug_catalog.schema.json",
  "title": "더잔잔 약 카탈로그 (DrugCatalog)",
  "description": "앱에 번들되는 읽기 전용 약 정보. 원문은 식약처 공공데이터를 그대로 싣고, 판단(용량 권고·상호작용·추천)은 포함하지 않는다.",
  "type": "object",
  "required": ["version", "source", "as_of", "items"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string",
      "description": "카탈로그 버전 (semver)",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "source": {
      "type": "object",
      "description": "앱 화면에 표기할 출처 정보",
      "required": ["name", "license"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "default": "식품의약품안전처 공공데이터포털"
        },
        "datasets": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["e약은요", "의약품 낱알식별 정보", "의약품 허가정보"]
          }
        },
        "license": {
          "type": "string",
          "default": "공공누리 제1유형 (출처 표시)"
        },
        "url": { "type": "string", "format": "uri" }
      }
    },
    "as_of": {
      "type": "string",
      "format": "date",
      "description": "데이터 기준일. 약 정보 카드 하단에 항상 노출."
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/drug" }
    }
  },
  "definitions": {
    "drug": {
      "type": "object",
      "required": ["id", "ingredient_ko", "brand_names", "dosage_form", "strengths"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "description": "카탈로그 내 고유 ID. Medication.catalogID 가 이 값을 참조.",
          "pattern": "^[a-z0-9_]+$"
        },
        "ingredient_ko": { "type": "string", "description": "성분명 (한글)" },
        "ingredient_en": { "type": "string", "description": "성분명 (영문 INN)" },
        "brand_names": {
          "type": "array",
          "description": "동일 성분의 국내 상품명 목록",
          "items": { "type": "string" },
          "minItems": 1
        },
        "manufacturer": { "type": "string", "description": "제약사" },
        "drug_class": {
          "type": "string",
          "description": "계열 (예: SSRI, SNRI, 비정형 항정신병약, 벤조디아제핀, 기분조절제, 수면제)"
        },
        "strengths": {
          "type": "array",
          "description": "규격 목록",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["value", "unit"],
            "additionalProperties": false,
            "properties": {
              "value": { "type": "number", "exclusiveMinimum": 0 },
              "unit": { "type": "string", "enum": ["mg", "mcg", "g", "mL"] }
            }
          }
        },
        "dosage_form": {
          "type": "string",
          "description": "제형",
          "examples": ["정제", "필름코팅정", "서방정", "구강붕해정", "경질캡슐", "산제", "내용액제"]
        },
        "indications_raw": {
          "type": "string",
          "description": "효능·효과 원문. 식약처 문구를 수정 없이 그대로."
        },
        "adverse_reactions_raw": {
          "type": "string",
          "description": "이상반응 원문. 수정 없이 그대로."
        },
        "precautions_raw": {
          "type": "string",
          "description": "사용상 주의사항 원문. 수정 없이 그대로."
        },
        "pill": {
          "type": "object",
          "description": "낱알식별 정보. '약 모양으로 찾기'의 검색 대상.",
          "additionalProperties": false,
          "properties": {
            "shape": {
              "type": "string",
              "description": "낱알 모양",
              "examples": ["원형", "타원형", "장방형", "삼각형", "사각형", "마름모형", "오각형", "육각형", "팔각형", "캡슐형", "기타"]
            },
            "color_front": { "type": "string", "description": "앞면 색" },
            "color_back": { "type": "string", "description": "뒷면 색" },
            "imprint_front": { "type": "string", "description": "앞면 각인. 부분 일치·대소문자 무시로 검색." },
            "imprint_back": { "type": "string", "description": "뒷면 각인" },
            "scored": { "type": "boolean", "description": "분할선 유무" },
            "length_mm": { "type": "number", "exclusiveMinimum": 0 },
            "thickness_mm": { "type": "number", "exclusiveMinimum": 0 },
            "image": {
              "type": "string",
              "description": "번들된 저해상 낱알 이미지 파일명 (앱 에셋 상대 경로). 오프라인 전용.",
              "pattern": "^[A-Za-z0-9._/-]+\\.(png|jpg|webp)$"
            }
          }
        },
        "source": {
          "type": "string",
          "description": "이 항목의 출처. 카탈로그 상위 source 와 다를 때만 지정."
        },
        "as_of": {
          "type": "string",
          "format": "date",
          "description": "이 항목의 기준일. 상위 as_of 와 다를 때만 지정."
        },
        "external_links": {
          "type": "array",
          "description": "앱 밖으로 여는 링크만. 내용을 복제하지 않는다 (예: 약학정보원).",
          "items": {
            "type": "object",
            "required": ["label", "url"],
            "additionalProperties": false,
            "properties": {
              "label": { "type": "string" },
              "url": { "type": "string", "format": "uri" }
            }
          }
        }
      }
    }
  }
}
